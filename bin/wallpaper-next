#!/usr/bin/env bash
# wallpaper-next        — следующая картинка по кругу
# wallpaper-next loop N — менять каждые N минут (по умолчанию 15)
DIR="$HOME/Pictures/Wallpapers"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper-idx"
mkdir -p "$(dirname "$STATE")"
next() {
  mapfile -t files < <(find "$DIR" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.png' \) | sort)
  [ "${#files[@]}" -gt 0 ] || exit 1
  i=$(( ($(cat "$STATE" 2>/dev/null || echo -1) + 1) % ${#files[@]} ))
  echo "$i" > "$STATE"
  CONF="$HOME/.config/hypr/hyprpaper.conf"
  sed -i "s|^\( *path = \).*|\1${files[$i]}|" "$CONF"
  pkill -x hyprpaper
  setsid hyprpaper >/dev/null 2>&1 &
}
if [ "$1" = loop ]; then
  while true; do sleep $(( ${2:-15} * 60 )); next; done
else
  next
fi
