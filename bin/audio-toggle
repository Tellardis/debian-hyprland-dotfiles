#!/usr/bin/env bash
# Переключает вывод звука: наушники (Kraken) <-> колонки (Built-in Audio)
status=$(wpctl status | sed -n '/Sinks:/,/Sources:/p')
id_of() { echo "$status" | grep -F "$1" | grep -v -i "fifine" | head -n1 | sed -E 's/^[^0-9]*([0-9]+)\..*/\1/'; }
head_id=$(id_of "Kraken")
spk_id=$(id_of "Built-in Audio")
cur=$(wpctl inspect @DEFAULT_AUDIO_SINK@ | grep -m1 'node.description')
if echo "$cur" | grep -q Kraken; then target=$spk_id; name="Колонки"; else target=$head_id; name="Наушники"; fi
[ -n "$target" ] || { notify-send "Звук" "Устройство не найдено"; exit 1; }
wpctl set-default "$target" && notify-send -h string:x-canonical-private-synchronous:audio -t 2000 "Звук" "$name"
